        f"Court date: {court_date or 'Not scheduled'}\n"
        f"Plate: {plate.upper()[:10] if plate else 'N/A'}\n"
        "Image:\n"
        f"Submitted by: {interaction.user.mention}"
    )

    file = None
    if image:
        try:
            file = await image.to_file()
