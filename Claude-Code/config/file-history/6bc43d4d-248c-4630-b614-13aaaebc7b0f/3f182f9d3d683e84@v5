        if file:
            await channel.send(
                content=content,
                file=file,
                allowed_mentions=discord.AllowedMentions(users=[interaction.user])
            )
        else:
            await channel.send(
                content=content,
                allowed_mentions=discord.AllowedMentions(users=[interaction.user])
            )
    except discord.Forbidden:
