            "secondary": reason[:50],
            "description": f"Citation issued to {user}: {reason} (Court: {court_date or 'None'})",
            "timestamp": time.time() * 1000
        })
        save_shift_data()

    embed = discord.Embed(
        title="Citation Successfully Logged",
